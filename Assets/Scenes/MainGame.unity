  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Hey...R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'm checking the logs in this computer.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'm trying to figure out if i can send a transport straight to here.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: But it seems like Victory cut off all lines from the station to the outside.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Damn it....
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: If i were you, i'd head over to the Securty to grab an access keycard.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'll stay here in case I do get in contact outside.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: .....
    speed: 0.2
    canRepeat: 1
    shown: 0
  _text: Talk to Winston
  displayText: {fileID: 0}
  hasTalkedToNPC: 1
