    shown: 0
  - text: The generators?R
    speed: 0.03
    canRepeat: 0
    shown: 0
  - text: It's all turned off...R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Nick destroyed the right generators.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: But he died before he could destroy the left one.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You can use the vent here.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: It's the only safe way to travel around here.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: It should lead you straight to the generator.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Go.... I need some time for myself.R
    speed: 0.025
    canRepeat: 1
    shown: 0
  _text: Talk
  displayText: {fileID: 433525660}
  hasTalkedToNPC: 0
