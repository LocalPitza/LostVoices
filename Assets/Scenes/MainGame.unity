  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: I see that most of the lights are turned on now.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Now lets get you up to working pace.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Go to Security in the left section of the station, get your access keycard
      and start working.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Again, you're hired to fix the life support system of the station, but
      if anything else pops up.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'll contact you.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'm cutting off the line now.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Again, Peter....L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Goodluck.L
    speed: 0.1
    canRepeat: 0
    shown: 0
  stopMove: 0
