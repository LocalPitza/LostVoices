--- !u!114 &44905133
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 44905130}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36db4ed05141b1444b57d8110eaf0468, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: I see you have the keycard.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I cant exactly tell you what to do now.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: But you need to find a way out of this place.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You were sent here to fix the life support systems.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: and You should, it's only a matter of time.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: The oxygen around this place is going to run out soon.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I've opened the Upper Left Gate, should lead you to the Suite.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: the other gates are all locked up, and there's only one way to open them.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Head to the staff offices.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Get into one of their terminals and open whatever gates still work.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'll warn you now though...R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Up there isn't exactly safe....R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: well... nowhere in this place is safe to be honest.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Goodluck.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: .....
    speed: 0.025
    canRepeat: 1
    shown: 0
  _text: Talk To Winston
  displayText: {fileID: 433525660}
  hasTalkedToNPC: 0
