  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: I see that all the lights are mostly on.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Now, lets get to working pace.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Again, you're here to help the other engineers.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Fix the station up, specially the life support system.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Help them out and I'll contact you if anything else comes up.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'll be cutting off the comms now.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Once again, Peter.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Goodluck.L
    speed: 0.03
    canRepeat: 0
    shown: 0
  stopMove: 0
