--- !u!114 &1819532453
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1819532451}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 36db4ed05141b1444b57d8110eaf0468, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Who're you suppose to be?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Wait.... are you my rescue?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: No?R
    speed: 0.03
    canRepeat: 0
    shown: 0
  - text: You're here to help us with the station?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: No... You don't understand....R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Something is out there.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Hunting us...R
    speed: 0.03
    canRepeat: 0
    shown: 0
  - text: Killing us one by one...R
    speed: 0.02
    canRepeat: 0
    shown: 0
  - text: It makes people go insane.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: It's still out there.... waiting.R
    speed: 0.03
    canRepeat: 0
    shown: 0
  - text: I suppose you're here for something.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: The generators?R
    speed: 0.03
    canRepeat: 0
    shown: 0
  - text: It's all turned off...R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You can use the vent here.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: It's the only safe way to travel around here.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Go.... I need some time for myself.R
    speed: 0.025
    canRepeat: 1
    shown: 0
  _text: Talk
  displayText: {fileID: 433525660}
  hasTalkedToNPC: 0
