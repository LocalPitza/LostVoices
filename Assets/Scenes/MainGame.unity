--- !u!114 &1819532455
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1819532451}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9ae434d1018e8ad45bc0ccc8cbe6c9cf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: What the....R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Who're you suppose to be?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Wait.... are you perhaps my rescue?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: No?R
    speed: 0.3
    canRepeat: 0
    shown: 0
  - text: You're here to help us?R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: No... You don't Understand.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Something's out there.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Hunting Us...R
    speed: 0.05
    canRepeat: 0
    shown: 0
  - text: Killing Us...R
    speed: 0.05
    canRepeat: 0
    shown: 0
  - text: Its out there...R
    speed: 0.05
    canRepeat: 0
    shown: 0
  - text: Waiting.R
    speed: 0.1
    canRepeat: 0
    shown: 0
  - text: You're here for the generator I suppose?.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Nick destroyed the Right Generators, but he died before he could destroy
      the Left one, You could still turn on the Left Generator.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: My name is Winston, use the vent inside here, that's your only way to the
      generator room.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Go... I need time for myself.R
    speed: 0.025
    canRepeat: 1
    shown: 0
  _text: Talk
  displayText: {fileID: 0}
  hasTalkedToNPC: 0
