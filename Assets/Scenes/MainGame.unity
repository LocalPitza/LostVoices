  m_Script: {fileID: 11500000, guid: 36db4ed05141b1444b57d8110eaf0468, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Hey there.... I didn't tell you my name.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'm winston, Primera B Systems Engineer.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: I'm trying to figure out if i can call a transport ship from the outside.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: All the comm lines are all cut off, I cant contact anyone outside.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Victory doesn't want to let anyone leave this god damn place.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You should go to the security, get an access keycard.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: It should help you move around this awful place.R
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: ....
    speed: 0.025
    canRepeat: 1
    shown: 0
  _text: Talk To Winston
  displayText: {fileID: 433525660}
  hasTalkedToNPC: 0
