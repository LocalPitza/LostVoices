  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Welcome aboard Primera B Station.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You have a task to do here, Peter.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: But before that you have to get in first.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Head to the security booth near you and open the gate.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: and sorry about all the clutter about.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: The other engineers wasn't exactly tidy with their work.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: We've given you a flashlight, Use it.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: (Press F to use Flashlight)
    speed: 0.05
    canRepeat: 0
    shown: 0
  stopMove: 0
