  m_Script: {fileID: 11500000, guid: cfb3a022553b3b64eb5bca745749274f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Behold! Primera B Hub.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Now about your job Peter.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: You're here to help the other engineers with fixing this place up.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Now the place might look rundown and all.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: But it's still managable.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: At least according to Victory.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Hang On.... Why are the lights all off?L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: ....L
    speed: 0.05
    canRepeat: 0
    shown: 0
  - text: The Generators must be turned off.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Go check it out peter.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: The generators are in the Upper Right Section of the station.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Goodluck.L
    speed: 0.02
    canRepeat: 0
    shown: 0
  stopMove: 0
