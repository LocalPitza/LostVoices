  m_Name: 
  m_EditorClassIdentifier: 
  dialogueEntries:
  - text: Behold, the Main Hall of the Station.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Your job is to fix this place up, alongside the other Engineers, well if
      they're still here.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Hang on, why is it all so dark.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: .....
    speed: 0.2
    canRepeat: 0
    shown: 0
  - text: The generators isn't working.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: They're on the Upper Right Section of the Station, go check it out.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  - text: Good luck Peter.L
    speed: 0.025
    canRepeat: 0
    shown: 0
  stopMove: 0
